{
  "$schema": "https://schema.tauri.app/v2",
  "identifier": "com.tauri.devtools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Dev Tools",
        "width": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "permissions": {
    "shell": {
      "all": true
    },
    "fs": {
      "scope": ["**"]
    },
    "clipboard": {
      "all": true
    },
    "global-shortcut": {
      "all": true
    },
    "store": {
      "all": true
    }
  }
}
